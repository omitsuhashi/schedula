{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPTIMAL",
        "FEASIBLE",
        "INFEASIBLE",
        "UNKNOWN",
        "INVALID_INPUT",
        "BACKEND_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    },
    "solver": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "none",
            "min_cost_flow",
            "cp_sat"
          ]
        },
        "engine_version": {
          "type": "string",
          "maxLength": 400
        },
        "library_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_reason": {
          "type": "string",
          "maxLength": 400
        }
      },
      "required": [
        "backend",
        "engine_version",
        "library_version",
        "selection_reason"
      ],
      "additionalProperties": false
    },
    "solution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "assignments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "employee_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
                  },
                  "role_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
                  },
                  "interval": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "end": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "employee_id",
                  "role_id",
                  "interval"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 1000000
            },
            "shifts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "candidate_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
                  },
                  "employee_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
                  },
                  "interval": {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "end": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  },
                  "breaks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "end": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0,
                    "maxItems": 10000
                  }
                },
                "required": [
                  "candidate_id",
                  "employee_id",
                  "interval",
                  "breaks"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 5000
            }
          },
          "required": [
            "assignments",
            "shifts"
          ],
          "additionalProperties": false
        }
      ]
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "metric": {
            "type": "string",
            "maxLength": 400
          },
          "value": {
            "type": "integer"
          },
          "proven_optimal": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "metric",
          "value",
          "proven_optimal"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 400
          },
          "message": {
            "type": "string",
            "maxLength": 400
          },
          "json_pointer": {
            "type": "string"
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "maxItems": 10000
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 10000
          }
        },
        "required": [
          "code",
          "message",
          "json_pointer",
          "related_ids",
          "facts"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "verification": {
      "type": "object",
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "maxLength": 400
              },
              "message": {
                "type": "string",
                "maxLength": 400
              },
              "json_pointer": {
                "type": "string"
              },
              "related_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0,
                "maxItems": 10000
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 10000
              }
            },
            "required": [
              "code",
              "message",
              "json_pointer",
              "related_ids",
              "facts"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "performed",
        "valid",
        "violations"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "elapsed_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "status",
    "solver",
    "solution",
    "objectives",
    "diagnostics",
    "verification",
    "stats"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillshift:response:0.1",
  "title": "SkillShift Response 0.1"
}
