      },
      {
        "id": "goals",
        "instruction": "目標だけAliceを2回、Bobを0回へ変え、実回数の交代を見る。",
        "restore": false,
        "changes": {
          "shift_count_balance": {
            "night_count": {
              "employee_targets": [
                {
                  "employee_id": "alice",
                  "target_count": 2
                },
                {
                  "employee_id": "bob",
                  "target_count": 0
                }
              ]
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 0,
          "actual_counts": {
            "alice": 2,
            "bob": 0
          }
        }
      },
      {
        "id": "zero",
        "instruction": "初期条件へ戻して両者を明示0回にする。偏差2回でも必須条件と需要は満たす。",
        "restore": true,
        "changes": {
          "shift_count_balance": {
            "night_count": {
              "employee_targets": [
                {
                  "employee_id": "alice",
                  "target_count": 0
                },
                {
                  "employee_id": "bob",
                  "target_count": 0
                }
              ]
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 2
        }
      },
      {
        "id": "unspecified",
        "instruction": "初期条件へ戻してAliceの目標を未指定にする。Bobだけが偏差の対象になる。",
        "restore": true,
        "changes": {
          "shift_count_balance": {
            "night_count": {
              "employee_targets": [
                {
                  "employee_id": "bob",
                  "target_count": 1
                }
              ]
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 0,
          "actual_counts": {
            "bob": 1
          }
        }
      },
      {
        "id": "classification",
        "instruction": "初期条件へ戻して分類区間の開始を22時、重なりの閾値を300分にする。勤務は残るが夜勤回数は0になる。",
        "restore": true,
        "changes": {
          "shift_categories": {
            "night": {
              "intervals": [
                {
                  "start": "2026-10-05T22:00:00+09:00",
                  "end": "2026-10-06T00:00:00+09:00"
                },
                {
                  "start": "2026-10-06T22:00:00+09:00",
                  "end": "2026-10-07T00:00:00+09:00"
                }
