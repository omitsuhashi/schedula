[
  {
    "id": "demand",
    "label": "必要人数に合わせる",
    "request_file": "demand-adjustment.json",
    "operation": "solve",
    "editable_fields": [
      {
        "collection": "demand",
        "ids": [
          "hall_2",
          "hall_3"
        ],
        "field": "required_people",
        "label": "12:00〜13:00のホールの必要人数",
        "unit": "人",
        "min": 0,
        "max": 6
      }
    ],
    "indicators": [
      "shortage_summary.total_person_minutes",
      "demand.required_people",
      "配置人数"
    ],
    "steps": [
      {
        "id": "initial",
        "instruction": "初期条件で計算し、必要人数と配置人数、不足0人分を確認する。",
        "restore": false,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "assigned_slots": 22,
          "total_person_minutes": 0
        }
      },
      {
        "id": "covered",
        "instruction": "12:00〜13:00のホールを2人から3人へ変更する。配置は増え、不足は0人分のままになる。",
        "restore": false,
        "changes": {
          "demand": {
            "hall_2": {
              "required_people": 3
            },
            "hall_3": {
              "required_people": 3
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "assigned_slots": 24,
          "total_person_minutes": 0
        }
      },
      {
        "id": "shortage",
        "instruction": "同じ2枠のホールを4人へ増やし、元の必要人数を保持した不足を確認する。",
        "restore": false,
        "changes": {
          "demand": {
            "hall_2": {
              "required_people": 4
            },
            "hall_3": {
              "required_people": 4
            }
          }
        },
        "expected": {
          "status": "PARTIAL",
          "assigned_slots": 24,
          "total_person_minutes": 60
        }
      },
      {
        "id": "restored",
        "instruction": "初期条件へ復元して再計算する。",
        "restore": true,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "assigned_slots": 22,
          "total_person_minutes": 0
        }
      }
    ]
  },
  {
    "id": "consecutive_days",
    "label": "連続勤務日数を制限する",
    "request_file": "consecutive-days.json",
    "operation": "solve",
    "editable_fields": [
      {
        "collection": "constraints",
        "ids": [
          "consecutive"
        ],
        "field": "limit_days",
        "label": "連勤上限",
        "unit": "日",
        "min": 1,
        "max": 7
      },
      {
        "collection": "employees",
        "ids": [
          "b",
          "c"
        ],
        "field": "availability",
        "label": "交代要員の勤務可能時間",
        "unit": "日付・時刻・Asia/Tokyo"
      },
      {
        "collection": "employees",
        "ids": [
          "a"
        ],
        "field": "history",
        "label": "計画前の最終勤務と連勤",
        "unit": "日付・時刻・日"
      }
    ],
    "indicators": [
      "最大連勤日数（履歴を含む）",
      "計画内の勤務日",
      "計画初日からの連勤",
      "shortage_summary.total_person_minutes"
    ],
    "steps": [
      {
        "id": "initial",
        "instruction": "上限5日で、需要充足と3日を超える連勤を確認する。",
        "restore": false,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "max_consecutive_days": 5,
          "first_run_a": 5
        }
      },
      {
        "id": "shorter",
        "instruction": "連勤上限だけを3日へ変更し、需要を充足したまま全員3日以内になることを確認する。",
        "restore": false,
        "changes": {
          "constraints": {
            "consecutive": {
              "limit_days": 3
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "max_consecutive_days": 3
        }
      },
      {
        "id": "fewer_backups",
        "instruction": "B・Cの勤務可能日を10月10・11日だけに減らし、連勤上限を保った不足を確認する。",
        "restore": false,
        "changes": {
          "employees": {
            "b": {
              "availability": [
                {
                  "start": "2026-10-10T00:00:00+09:00",
                  "end": "2026-10-12T00:00:00+09:00"
                }
              ]
            },
            "c": {
              "availability": [
                {
                  "start": "2026-10-10T00:00:00+09:00",
                  "end": "2026-10-12T00:00:00+09:00"
                }
              ]
            }
          }
        },
        "expected": {
          "status": "PARTIAL",
          "total_person_minutes": 60,
          "max_consecutive_days": 3
        }
      },
      {
        "id": "history",
        "instruction": "初期条件へ戻したうえで、Aに10月4日10:00終了・開始日4日・直前まで3連勤の履歴を追加する。",
        "restore": true,
        "changes": {
          "employees": {
            "a": {
              "history": {
                "last_shift_end": "2026-10-04T10:00:00+09:00",
                "last_work_day": "2026-10-04",
                "consecutive_work_days_before_window": 3
              }
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "max_consecutive_days": 5,
          "first_run_a_max": 2
        }
      },
      {
        "id": "restored",
        "instruction": "初期条件へ復元し、履歴も空に戻して再計算する。",
        "restore": true,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "max_consecutive_days": 5,
          "first_run_a": 5
        }
      }
    ]
  },
  {
    "id": "shift_count_balance",
    "label": "夜勤などの勤務回数を調整する",
    "request_file": "night-count.json",
    "operation": "solve",
    "intro": "Aliceの10月5日の確認済み夜勤1件と、6日に選ぶ夜勤1件を評価します。目標は近づけたい回数であり、必須条件ではありません。未指定者は対象外、明示0は0回の目標です。",
    "editable_fields": [
      {
        "collection": "shift_count_balance",
        "ids": [
          "night_count"
        ],
        "field": "employee_targets",
        "label": "個人別の目標勤務回数",
        "unit": "回"
      },
      {
        "collection": "shift_categories",
        "ids": [
          "night"
        ],
        "field": "intervals",
        "label": "夜勤の分類区間",
        "unit": "日付・時刻・Asia/Tokyo"
      },
      {
        "collection": "shift_categories",
        "ids": [
          "night"
        ],
        "field": "min_overlap_minutes",
        "label": "分類に必要な重なり",
        "unit": "分",
        "min": 1,
        "max": 480
      }
    ],
    "indicators": [
      "個人別の目標勤務回数",
      "実績・選択勤務を含む勤務回数",
      "絶対偏差",
      "勤務分類の明示区間と閾値",
      "shortage_summary.total_person_minutes"
    ],
    "steps": [
      {
        "id": "initial",
        "instruction": "両者の目標1回で、Aliceの実績とBobの選択勤務を含む実回数・偏差を見る。",
        "restore": false,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 0,
          "actual_counts": {
            "alice": 1,
            "bob": 1
          }
        }
      },
      {
        "id": "goals",
        "instruction": "目標だけAliceを2回、Bobを0回へ変え、実回数の交代を見る。",
        "restore": false,
        "changes": {
          "shift_count_balance": {
            "night_count": {
              "employee_targets": [
                {
                  "employee_id": "alice",
                  "target_count": 2
                },
                {
                  "employee_id": "bob",
                  "target_count": 0
                }
              ]
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 0,
          "actual_counts": {
            "alice": 2,
            "bob": 0
          }
        }
      },
      {
        "id": "zero",
        "instruction": "初期条件へ戻して両者を明示0回にする。偏差2回でも必須条件と需要は満たす。",
        "restore": true,
        "changes": {
          "shift_count_balance": {
            "night_count": {
              "employee_targets": [
                {
                  "employee_id": "alice",
                  "target_count": 0
                },
                {
                  "employee_id": "bob",
                  "target_count": 0
                }
              ]
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 2
        }
      },
      {
        "id": "unspecified",
        "instruction": "初期条件へ戻してAliceの目標を未指定にする。Bobだけが偏差の対象になる。",
        "restore": true,
        "changes": {
          "shift_count_balance": {
            "night_count": {
              "employee_targets": [
                {
                  "employee_id": "bob",
                  "target_count": 1
                }
              ]
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 0,
          "actual_counts": {
            "bob": 1
          }
        }
      },
      {
        "id": "classification",
        "instruction": "初期条件へ戻して分類区間の開始を22時、重なりの閾値を300分にする。勤務は残るが夜勤回数は0になる。",
        "restore": true,
        "changes": {
          "shift_categories": {
            "night": {
              "intervals": [
                {
                  "start": "2026-10-05T22:00:00+09:00",
                  "end": "2026-10-06T00:00:00+09:00"
                },
                {
                  "start": "2026-10-06T22:00:00+09:00",
                  "end": "2026-10-07T00:00:00+09:00"
                }
              ],
              "min_overlap_minutes": 300
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 2,
          "actual_counts": {
            "alice": 0,
            "bob": 0
          }
        }
      },
      {
        "id": "restored",
        "instruction": "初期条件と目標1回・分類区間20時開始・閾値60分へ復元する。",
        "restore": true,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 0,
          "actual_counts": {
            "alice": 1,
            "bob": 1
          }
        }
      }
    ]
  },
  {
    "id": "verify",
    "label": "手で直した計画を検証する",
    "request_file": "manual-verify.json",
    "solution_file": "manual-verify.solution.json",
    "operation": "verify",
    "intro": "10月5日10:00〜11:00のキッチン担当一枠だけを編集します。ホールはBob、選択勤務2件は固定です。公開verifyは探索せず、最適性・不足最小性を認定しません。",
    "editable_fields": [
      {
        "collection": "solution",
        "field": "assignments",
        "label": "10月5日10:00〜11:00のキッチン担当",
        "unit": "従業員"
      }
    ],
    "indicators": [
      "公開verifyの状態",
      "verification.violations の位置",
      "shortage_summary.total_person_minutes"
    ],
    "steps": [
      {
        "id": "initial",
        "instruction": "Aliceのキッチン、Bobのホールを公開verifyで検証する。",
        "restore": false,
        "changes": {},
        "expected": {
          "status": "VALID",
          "total_person_minutes": 0
        }
      },
      {
        "id": "invalid",
        "instruction": "キッチンをBobへ変更する。二重配置の無効案を違反位置付きで確認する。",
        "restore": false,
        "changes": {
          "kitchen_employee": "bob"
        },
        "expected": {
          "status": "INVALID_PLAN",
          "total_person_minutes": null
        }
      },
      {
        "id": "partial",
        "instruction": "キッチンを担当なしへ変更する。必須条件は満たすが不足60人分が残る。",
        "restore": false,
        "changes": {
          "kitchen_employee": ""
        },
        "expected": {
          "status": "PARTIAL",
          "total_person_minutes": 60
        }
      },
      {
        "id": "valid",
        "instruction": "キッチンをAliceへ直して再検証する。",
        "restore": false,
        "changes": {
          "kitchen_employee": "alice"
        },
        "expected": {
          "status": "VALID",
          "total_person_minutes": 0
        }
      },
      {
        "id": "restored",
        "instruction": "初期の編集案と公開検証結果へ復元する。",
        "restore": true,
        "changes": {},
        "expected": {
          "status": "VALID",
          "total_person_minutes": 0
        }
      }
    ]
  }
