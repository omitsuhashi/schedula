  {
    "id": "demand",
    "label": "必要人数に合わせる",
    "request_file": "demand-adjustment.json",
    "operation": "solve",
    "editable_fields": [
      {
        "collection": "demand",
        "ids": [
          "hall_2",
          "hall_3"
        ],
        "field": "required_people",
        "label": "12:00〜13:00のホールの必要人数",
        "unit": "人",
        "min": 0,
        "max": 6
      }
    ],
    "indicators": [
      "shortage_summary.total_person_minutes",
      "demand.required_people",
      "配置人数"
    ],
    "steps": [
      {
        "id": "initial",
        "instruction": "初期条件で計算し、必要人数と配置人数、不足0人分を確認する。",
        "restore": false,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "assigned_slots": 22,
          "total_person_minutes": 0
        }
      },
      {
        "id": "covered",
        "instruction": "12:00〜13:00のホールを2人から3人へ変更する。配置は増え、不足は0人分のままになる。",
        "restore": false,
        "changes": {
          "demand": {
            "hall_2": {
              "required_people": 3
            },
            "hall_3": {
              "required_people": 3
            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "assigned_slots": 24,
          "total_person_minutes": 0
        }
      },
      {
        "id": "shortage",
        "instruction": "同じ2枠のホールを4人へ増やし、元の必要人数を保持した不足を確認する。",
        "restore": false,
        "changes": {
          "demand": {
            "hall_2": {
              "required_people": 4
            },
            "hall_3": {
              "required_people": 4
            }
          }
        },
        "expected": {
          "status": "PARTIAL",
          "assigned_slots": 24,
          "total_person_minutes": 60
        }
      },
      {
        "id": "restored",
        "instruction": "初期条件へ復元して再計算する。",
        "restore": true,
        "changes": {},
        "expected": {
          "status": "OPTIMAL",
          "assigned_slots": 22,
          "total_person_minutes": 0
        }
      }
    ]
  },
