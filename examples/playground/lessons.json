            }
          }
        },
        "expected": {
          "status": "OPTIMAL",
          "total_person_minutes": 0,
          "total_deviation_count": 2,
          "actual_counts": {
            "alice": 0,
            "bob": 0
          }
        }
      },
      {
        "id": "restored",
