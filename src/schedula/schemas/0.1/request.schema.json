{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
    },
    "problem_type": {
      "enum": [
        "assignment",
        "roster"
      ]
    },
    "planning_window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "slot_minutes": {
          "type": "integer",
          "enum": [
            5,
            10,
            15,
            20,
            30,
            60
          ]
        }
      },
      "required": [
        "start",
        "end",
        "timezone",
        "slot_minutes"
      ],
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "maxLength": 400
          },
          "required_skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
                },
                "min_level": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "skill_id",
                "min_level"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "id",
          "label",
          "required_skills"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 50
    },
    "employees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "maxLength": 400
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
                },
                "level": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "skill_id",
                "level"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 100
          },
          "availability": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interval"
            },
            "minItems": 0,
            "maxItems": 3000
          },
          "history": {
            "type": "object",
            "properties": {
              "last_shift_end": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "consecutive_work_days_before_window": {
                "type": "integer",
                "minimum": 0,
                "maximum": 366
              }
            },
            "required": [
              "last_shift_end",
              "consecutive_work_days_before_window"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "skills",
          "availability"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 250
    },
    "demand": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "role_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "interval": {
            "$ref": "#/$defs/interval"
          },
          "required_people": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250
          }
        },
        "required": [
          "id",
          "role_id",
          "interval",
          "required_people"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "shift_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "employee_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "interval": {
            "$ref": "#/$defs/interval"
          },
          "breaks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/interval"
            },
            "minItems": 0,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "employee_id",
          "interval",
          "breaks"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "shift_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "employee_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
            },
            "minItems": 1,
            "maxItems": 250,
            "uniqueItems": true
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date"
            },
            "minItems": 1,
            "maxItems": 365,
            "uniqueItems": true
          },
          "start_times": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "minItems": 1,
            "maxItems": 96,
            "uniqueItems": true
          },
          "duration_minutes_options": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          },
          "break_options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "offset_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                },
                "duration_minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                }
              },
              "required": [
                "offset_minutes",
                "duration_minutes"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 30,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "employee_ids",
          "dates",
          "start_times",
          "duration_minutes_options",
          "break_options"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "type": {
                "const": "max_assigned_minutes"
              },
              "employee_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
                },
                "minItems": 1,
                "maxItems": 250,
                "uniqueItems": true
              },
              "limit_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "id",
              "type",
              "employee_ids",
              "limit_minutes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "type": {
                "const": "max_scheduled_minutes"
              },
              "employee_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
                },
                "minItems": 1,
                "maxItems": 250,
                "uniqueItems": true
              },
              "limit_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "id",
              "type",
              "employee_ids",
              "limit_minutes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "type": {
                "const": "min_rest_minutes"
              },
              "employee_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
                },
                "minItems": 1,
                "maxItems": 250,
                "uniqueItems": true
              },
              "limit_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "id",
              "type",
              "employee_ids",
              "limit_minutes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "type": {
                "const": "max_consecutive_days"
              },
              "employee_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
                },
                "minItems": 1,
                "maxItems": 250,
                "uniqueItems": true
              },
              "limit_days": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "id",
              "type",
              "employee_ids",
              "limit_days"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "type": {
                "const": "max_role_switches"
              },
              "employee_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
                },
                "minItems": 1,
                "maxItems": 250,
                "uniqueItems": true
              },
              "limit_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              }
            },
            "required": [
              "id",
              "type",
              "employee_ids",
              "limit_count"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "type": {
            "const": "avoid_role"
          },
          "employee_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
            },
            "minItems": 1,
            "maxItems": 250,
            "uniqueItems": true
          },
          "role_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "penalty_per_minute": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "id",
          "type",
          "employee_ids",
          "role_id",
          "penalty_per_minute"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "metric": {
            "enum": [
              "preference_penalty",
              "scheduled_minutes",
              "role_switches"
            ]
          }
        },
        "required": [
          "id",
          "metric"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 3
    },
    "solver": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "auto",
            "min_cost_flow",
            "cp_sat"
          ]
        },
        "time_limit_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "backend",
        "time_limit_seconds",
        "seed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "problem_type",
    "planning_window",
    "skills",
    "roles",
    "employees",
    "demand",
    "shift_candidates",
    "constraints",
    "preferences",
    "objectives",
    "solver"
  ],
  "additionalProperties": false,
  "$defs": {
    "interval": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  },
  "description": "配列は明示する。需要は厳密な人数、未指定需要は0。未導入のモード・条件は意味検証で拒否する。",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schedula:request:0.1",
  "title": "schedula Request 0.1"
}
