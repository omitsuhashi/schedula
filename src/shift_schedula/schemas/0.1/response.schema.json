{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPTIMAL",
        "FEASIBLE",
        "INFEASIBLE",
        "UNKNOWN",
        "INVALID_INPUT",
        "BACKEND_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    },
    "solver": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "none",
            "min_cost_flow",
            "cp_sat"
          ]
        },
        "engine_version": {
          "type": "string",
          "maxLength": 400
        },
        "library_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_reason": {
          "type": "string",
          "maxLength": 400
        }
      },
      "required": [
        "backend",
        "engine_version",
        "library_version",
        "selection_reason"
      ],
      "additionalProperties": false
    },
    "solution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/solution"
        }
      ]
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
          },
          "metric": {
            "type": "string",
            "maxLength": 400
          },
          "value": {
            "type": "integer"
          },
          "proven_optimal": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "metric",
          "value",
          "proven_optimal"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "verification": {
      "type": "object",
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "performed",
        "valid",
        "violations"
      ],
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "elapsed_seconds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "status",
    "solver",
    "solution",
    "objectives",
    "diagnostics",
    "verification",
    "stats"
  ],
  "additionalProperties": false,
  "$defs": {
    "interval": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "solution": {
      "type": "object",
      "properties": {
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "employee_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "role_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "interval": {
                "$ref": "#/$defs/interval"
              }
            },
            "required": [
              "employee_id",
              "role_id",
              "interval"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000000
        },
        "shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "employee_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}(?![\\s\\S])"
              },
              "interval": {
                "$ref": "#/$defs/interval"
              },
              "breaks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/interval"
                },
                "minItems": 0,
                "maxItems": 10000
              }
            },
            "required": [
              "candidate_id",
              "employee_id",
              "interval",
              "breaks"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "assignments",
        "shifts"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 400
        },
        "message": {
          "type": "string",
          "maxLength": 400
        },
        "json_pointer": {
          "type": "string"
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "code",
        "message",
        "json_pointer",
        "related_ids",
        "facts"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "OPTIMAL",
              "FEASIBLE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "solution": {
            "$ref": "#/$defs/solution"
          },
          "verification": {
            "properties": {
              "performed": {
                "const": true
              },
              "valid": {
                "const": true
              },
              "violations": {
                "maxItems": 0
              }
            }
          },
          "solver": {
            "properties": {
              "backend": {
                "enum": [
                  "min_cost_flow",
                  "cp_sat"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "solution": {
            "type": "null"
          },
          "objectives": {
            "maxItems": 0
          },
          "verification": {
            "properties": {
              "valid": {
                "enum": [
                  false,
                  null
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "performed": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "valid": {
                "type": "null"
              },
              "violations": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "OPTIMAL"
          }
        }
      },
      "then": {
        "properties": {
          "objectives": {
            "items": {
              "properties": {
                "proven_optimal": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "performed": {
                "const": true
              },
              "valid": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "INTERNAL_ERROR"
          },
          "verification": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "performed": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "valid": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schedula:response:0.1",
  "title": "schedula Response 0.1"
}
