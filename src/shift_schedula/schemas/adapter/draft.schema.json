{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schedula:adapter:draft:1.0",
  "type": "object",
  "properties": {
    "adapter_version": {
      "const": "1.0"
    },
    "schema_version": {
      "const": "0.15"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 32
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "json_pointer": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "source_id",
          "json_pointer",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "target_source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "constraint_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "before": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "source_id",
          "target_source_id",
          "constraint_id",
          "before",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "order": {
      "type": "object",
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "adapter_version",
    "schema_version",
    "sources",
    "unresolved",
    "assumptions",
    "overrides",
    "order"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "section": {
          "enum": [
            "basic",
            "common",
            "period",
            "history",
            "replanning",
            "execution",
            "imported"
          ]
        },
        "origin": {
          "enum": [
            "declared",
            "unknown"
          ]
        },
        "data": {
          "type": "object"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "applies_to": {
          "type": [
            "object",
            "null"
          ]
        },
        "confirmation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "provenance": {
                  "enum": [
                    "declared",
                    "unknown"
                  ]
                }
              },
              "required": [
                "digest",
                "provenance"
              ],
              "additionalProperties": false
            }
          ]
        },
        "file": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "revision",
        "section",
        "origin",
        "data",
        "references",
        "applies_to",
        "confirmation"
      ],
      "additionalProperties": false
    }
  }
}
